# Copy to .env and fill in. NEVER commit a real .env.
# Generate a secret: openssl rand -hex 32

NODE_ENV=development
BACKEND_PORT=3000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=criterium
# Log every SQL statement. Keep false outside debugging.
DB_LOGGING=false
# Connection pool size. Keep below the server's max_connections divided by the
# number of replicas.
DB_POOL_SIZE=10

# --- Auth ---
# Minimum 32 characters. Must differ per environment.
JWT_SECRET=
JWT_EXPIRATION_TIME=1d
BCRYPT_ROUNDS=12
# 64 hex characters. Encrypts the provider credentials kept in app_settings,
# so a database dump does not hand over the OpenAI key. Changing it makes
# every already-stored secret unreadable.
SETTINGS_ENCRYPTION_KEY=

# Where the browser reaches this deployment. One-time password links are
# built from it.
APP_BASE_URL=http://localhost:5173

# --- HTTP ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Swagger UI at /api/docs. Keep false in production.
SWAGGER_ENABLED=true
# How many reverse proxies sit in front of the API. 0 when it is reached
# directly; 1 behind the frontend's nginx or a single ingress. Rate limiting
# and the audit log read the client address through this, so a wrong value
# either shares one bucket between every client or lets a client forge its
# own address.
TRUST_PROXY_HOPS=0
# Bulk imports post large JSON documents.
BODY_LIMIT=10mb

# --- Logging ---
LOG_LEVEL=info

# --- Frontend (Vite, build time) ---
# Relative by default: nginx proxies /api to the backend on the same origin.
# Set an absolute URL only when the API is served from another origin.
VITE_API_URL=/api/v1
