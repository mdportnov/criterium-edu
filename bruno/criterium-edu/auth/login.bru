meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@example.com",
    "password": "Passw0rd!23"
  }
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns the profile, and no token in the body", function() {
    expect(res.body).to.have.property('email');
    expect(res.body).to.not.have.property('access_token');
  });

  test("sets an httpOnly session cookie", function() {
    const cookies = res.headers['set-cookie'] || [];
    const session = cookies.find((c) => c.startsWith('criterium_session='));
    expect(session, 'criterium_session cookie').to.be.a('string');
    expect(session).to.include('HttpOnly');
  });

  // Writes need this echoed back in an X-CSRF-Token header.
  const csrf = (res.headers['set-cookie'] || [])
    .find((c) => c.startsWith('criterium_csrf='));
  if (csrf) {
    bru.setVar("csrfToken", csrf.split(';')[0].split('=')[1]);
  }
}

docs {
  Signing in sets two cookies: criterium_session (httpOnly, the actual
  session) and criterium_csrf (readable, echoed back on every write).
  Bruno stores and resends them automatically.
}
