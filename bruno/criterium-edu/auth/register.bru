meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "new.user@example.com",
    "firstName": "New",
    "lastName": "User",
    "password": "Passw0rd!23"
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });

  test("new accounts are students", function() {
    expect(res.body.role).to.equal('student');
  });
}

docs {
  Registration can be switched off in the admin settings, in which case this
  returns 403. It always creates a student, whatever the payload asks for.
}
