{
  "name": "criterium-edu",
  "version": "1.0.0",
  "description": "Educational platform for task solutions and reviews",
  "scripts": {
    "nx": "nx",
    "start": "nx serve",
    "build": "nx build",
    "lint": "nx lint",
    "affected": "nx affected",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:lint": "nx affected:lint",
    "api:serve": "nx serve api",
    "api:build": "nx build api",
    "api:build:migrations": "tsc apps/api/src/database/migrations/*.ts apps/api/src/database/data-source*.ts --outDir dist/apps/api/src/database --target ES2022 --module commonjs --esModuleInterop --experimentalDecorators --emitDecoratorMetadata --moduleResolution node",
    "api:build:all": "nx run-many --target=build --projects=api --configuration=production && nx run api:build:migrations",
    "api:lint": "nx lint api",
    "web:serve": "nx serve web",
    "web:build": "nx build web",
    "web:lint": "nx lint web",
    "shared:build": "nx build shared",
    "build:all": "nx run-many --target=build --all --configuration=production",
    "lint:all": "nx run-many --target=lint --all",
    "typeorm:generate": "nx run api:typeorm:generate",
    "typeorm:migrate": "npm run api:build:migrations && npx typeorm migration:run -d dist/apps/api/src/database/data-source.js",
    "typeorm:revert": "nx run api:typeorm:revert",
    "docker:build:api": "nx run api:docker-build",
    "docker:build:web": "nx run web:docker-build",
    "docker:build:all": "nx run-many --target=docker-build --all",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "help": "nx help",
    "test": "nx run-many --target=test --all",
    "test:api": "nx test api",
    "test:web": "nx test web",
    "typecheck": "tsc -b tsconfig.json",
    "verify": "npm run lint:all && npm run test && npm run build:all"
  },
  "keywords": [
    "education",
    "task",
    "review",
    "platform",
    "nx",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^11.0.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^4.3.1",
    "openai": "^4.104.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.7.0",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "^4.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.3",
    "@types/passport-jwt": "^4.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "30.1.0",
    "nx": "23.2.1",
    "prettier": "^3.9.7",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "3.2.7",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
