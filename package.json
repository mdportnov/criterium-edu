    "@types/cookie-parser": "1.4.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
