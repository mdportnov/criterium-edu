{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "isolatedConfig": true,
        "webpackConfig": "apps/api/webpack.config.js",
        "generatePackageJson": true
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "fileReplacements": [
            {
              "replace": "apps/api/src/environments/environment.ts",
              "with": "apps/api/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false
        }
      },
      "defaultConfiguration": "production"
    },
    "build:migrations": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc apps/api/src/database/migrations/*.ts apps/api/src/database/data-source*.ts --outDir dist/apps/api/src/database --target ES2022 --module commonjs --esModuleInterop --experimentalDecorators --emitDecoratorMetadata --moduleResolution node --skipLibCheck"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "api:build:development",
        "watch": true
      },
      "configurations": {
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/api/**/*.ts"]
      }
    },
    "typeorm:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node -P apps/api/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d apps/api/src/database/data-source.ts"
      }
    },
    "typeorm:migrate": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:migrations"],
      "options": {
        "command": "npx typeorm migration:run -d dist/apps/api/src/database/data-source.js"
      }
    },
    "typeorm:revert": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:migrations"],
      "options": {
        "command": "npx typeorm migration:revert -d dist/apps/api/src/database/data-source.js"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f backend.Dockerfile -t criterium-backend ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --config apps/api/vitest.config.ts"
      },
      "configurations": {
        "watch": {
          "command": "vitest --config apps/api/vitest.config.ts"
        },
        "coverage": {
          "command": "vitest run --coverage --config apps/api/vitest.config.ts"
        }
      }
    }
  }
}
